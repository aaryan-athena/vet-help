# Base URL of the VetDx API.
#
# Local dev: leave this UNSET. The Vite dev server proxies /api -> :8000.
# Deployed:  REQUIRED. Set it to your deployed API origin, e.g.
#
#   VITE_API_BASE=https://vet-help-iota.vercel.app
#
# Trailing slashes are stripped automatically (see normalizeBase in src/api.js),
# because "https://host/" would otherwise produce a request to "https://host//schema",
# which the platform answers with a 308 redirect carrying no CORS headers --
# browsers block that, and the app reports the backend as unreachable even
# though it is healthy. Writing it without the slash is still the cleaner habit.
#
# Vite inlines this at BUILD time, so changing it requires a redeploy.
VITE_API_BASE=http://127.0.0.1:8000
